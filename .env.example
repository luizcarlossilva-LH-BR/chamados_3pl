# 3PL Chamados - Environment Variables
# Copie para .env.local e nunca comite valores reais.

# Google Sheets
# URL da planilha: docs.google.com/spreadsheets/d/[ESTE_ID]/edit
GOOGLE_SHEETS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ_exemplo

# Vercel Blob
# Criado automaticamente pela integracao Storage > Blob no Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Google Service Account
# 1. Crie uma service account no Google Cloud.
# 2. Ative a Google Sheets API.
# 3. Gere uma chave JSON.
# 4. Compartilhe a planilha com o client_email da service account como Editor.
# 5. Cole o JSON inteiro como string minificada.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"3pl-chamados@projeto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Gmail (envio de e-mail de acesso ao aprovar solicitacao)
# Reaproveita a mesma Service Account acima via domain-wide delegation.
# No Admin Console do Google Workspace (Seguranca > Controle de API > Delegacao em todo o dominio),
# autorize o client_id da service account com o escopo:
#   https://www.googleapis.com/auth/gmail.send
# GMAIL_SENDER_EMAIL e a conta do Workspace que a service account vai impersonar para enviar os e-mails.
GMAIL_SENDER_EMAIL=luiz.carlossilva@shopee.com

# JWT
# Obrigatorio. Use no minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_uma_string_aleatoria_longa_32_chars_minimo

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
